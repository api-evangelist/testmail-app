                  "raw": "{\n  \"query\": \"query {\\n  inbox(namespace: \\\"mynamespace\\\") {\\n    result\\n    count\\n    emails {\\n      from\\n      to\\n      subject\\n      text\\n      tag\\n      timestamp\\n    }\\n  }\\n}\\n\"\n}",
