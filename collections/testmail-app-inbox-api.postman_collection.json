  "item": [
    {
      "id": "a3641c0c-18e0-4e3b-80cd-677a1d64a46e",
      "name": "Inbox",
      "description": {
        "content": "Retrieve test emails from programmable inboxes",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8465f982-c32c-49b7-9e38-2b9c7e5b3145",
          "name": "Retrieve emails from a namespace inbox",
          "request": {
            "name": "Retrieve emails from a namespace inbox",
            "description": {
              "content": "Retrieves test emails from the specified namespace inbox. Supports filtering by tag, timestamp range, and pagination. Optionally waits for new emails with the livequery parameter. If livequery is active and no matching emails arrive within 60 seconds, the server returns HTTP 307 and the client must follow the redirect and resend the request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API authentication key retrieved from the developer console."
                },
                {
                  "disabled": false,
                  "key": "namespace",
                  "value": "<string>",
                  "description": "(Required) Target namespace identifier. Emails are routed to {namespace}.{tag}@inbox.testmail.app."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Filter by exact tag match."
                },
                {
                  "disabled": false,
                  "key": "tag_prefix",
                  "value": "<string>",
                  "description": "Filter by tag prefix (wildcard prefix search)."
                },
                {
                  "disabled": false,
                  "key": "timestamp_from",
                  "value": "<long>",
                  "description": "Start time filter in milliseconds since Unix epoch."
                },
                {
                  "disabled": false,
                  "key": "timestamp_to",
                  "value": "<long>",
                  "description": "End time filter in milliseconds since Unix epoch."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of emails to return per request."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of emails to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "livequery",
                  "value": "false",
                  "description": "When true, the server waits for new matching emails before responding. Returns HTTP 307 after 60 seconds if no emails arrive; client must follow redirects."
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "false",
                  "description": "When true, prettifies (indents) the JSON response output."
                },
                {
                  "disabled": false,
                  "key": "headers",
                  "value": "false",
                  "description": "When true, includes raw email headers in each email object."
                },
                {
                  "disabled": false,
                  "key": "spam_report",
                  "value": "false",
                  "description": "When true, includes SpamAssassin spam analysis data (spam_score and spam_report) in each email object."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
